# Copy to .env. Never commit real values.
CA_LLM_API_KEY=your_groq_api_key
CA_LLM_FAST_MODELS=["openai/gpt-oss-20b","openai/gpt-oss-120b"]
CA_LLM_STRONG_MODELS=["openai/gpt-oss-120b","openai/gpt-oss-20b"]
CA_JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
CA_LOG_LEVEL=INFO
# Local dev without Docker: in-memory data, lexical embeddings, no auth.
# CA_DATA_BACKEND=memory
# CA_AUTH_DISABLED=true
